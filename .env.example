# Generate both values independently with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-master-password
WAYMINDER_DB_PASSWORD=replace-with-a-random-application-password
# A shared token is suitable only for local development or migration. Generate
# it independently with `openssl rand -hex 32`; leave it empty in production.
WAYMINDER_AUTH_TOKEN=
# Production deployments use the hash-only registered-client file.
WAYMINDER_CLIENTS_FILE=
# WAYMINDER_CLIENTS_FILE=/run/secrets/wayminder-clients.json
WAYMINDER_RATE_LIMIT_PER_MINUTE=120
WAYMINDER_RATE_LIMIT_BURST=30

# Bind to localhost when a reverse proxy runs on the deployment host. Use an explicit private
# address only when clients connect directly over a trusted network.
WAYMINDER_BIND_ADDRESS=127.0.0.1
WAYMINDER_PORT=8080
WAYMINDER_ALLOWED_HOSTS=localhost,127.0.0.1,wayminder.example.com

WAYMINDER_EMBED_MODEL=nomic-embed-text
WAYMINDER_EMBED_DIMENSION=768
WAYMINDER_DEDUP_THRESHOLD=0.92
